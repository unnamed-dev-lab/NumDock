# Explicit local development mode; defaults to production when unset.
APP_ENV=development
# Optional seed password (12-128 characters). The Windows seed task generates one if empty.
DEV_SEED_PASSWORD=
DATABASE_URL=postgres://numdock:numdock_dev_only@127.0.0.1:55432/numdock?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:3000
# Only disable secure cookies on loopback HTTP during development.
COOKIE_SECURE=false
# Comma-separated IPs or CIDRs of trusted reverse proxies. Leave empty to trust none.
# Only list proxies that overwrite or append X-Forwarded-For themselves.
TRUSTED_PROXIES=

# OpenTelemetry: SDK instrumentation is enabled by default in development only.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=numdock-api
# Optional OTLP HTTP collector base URL. Empty means no external export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Required for development: Base64 of 32 random bytes. Windows script initializes .local/data-encryption-key.
DATA_ENCRYPTION_KEY=
