# Explicit local development mode; defaults to production when unset.
APP_ENV=development
# Optional seed password (12-128 characters). The Windows seed task generates one if empty.
DEV_SEED_PASSWORD=
# Local development only. Replace the password before starting PostgreSQL.
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgres://numdock:replace_with_a_local_password@127.0.0.1:55432/numdock?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Comma-separated IPs or CIDRs of trusted reverse proxies. Leave empty to trust none.
# Only list proxies that overwrite or append X-Forwarded-For themselves.
TRUSTED_PROXIES=
